# ==============================================================================
# GroundUp AI - Complete Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting the development environment:
#   cp .env.example .env
#
# For standalone backend execution:
#   cp backend/.env.example backend/.env
#
# For standalone frontend execution:
#   cp frontend/.env.example frontend/.env.local
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL 16)
# ------------------------------------------------------------------------------
# PostgreSQL credentials used by docker-compose.yml and local backend services.
# The host port is mapped to 5436 by default to prevent conflicts with local
# PostgreSQL instances running on the default 5432 port.
POSTGRES_USER=groundup
POSTGRES_PASSWORD=groundup_password
POSTGRES_DB=groundup_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5436

# Synchronous connection string (used by Alembic migrations & psycopg2 driver)
DATABASE_URL=postgresql+psycopg2://groundup:groundup_password@localhost:5436/groundup_db

# Asynchronous connection string (used by FastAPI async SQLAlchemy & asyncpg driver)
ASYNC_DATABASE_URL=postgresql+asyncpg://groundup:groundup_password@localhost:5436/groundup_db

# Enable verbose SQL query logging in console (true / false)
DB_ECHO=false

# ------------------------------------------------------------------------------
# 2. APPLICATION & SERVER SETTINGS
# ------------------------------------------------------------------------------
PROJECT_NAME="GroundUp AI API"
VERSION="0.1.0"
API_V1_STR="/api/v1"
ENV=development
DEBUG=true

# Server host and port for local API execution
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# CORS Allowed Origins
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000","http://127.0.0.1:8000"]

# ------------------------------------------------------------------------------
# 3. SECURITY & AUTHENTICATION (JWT & Cryptography)
# ------------------------------------------------------------------------------
# Secret key used for signing JWT access and refresh tokens.
# IMPORTANT: Generate a secure 64+ char random string for production environments:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=groundup-dev-secret-key-change-in-production-min-32-chars-long

# JWT cryptographic algorithm
ALGORITHM=HS256

# Token expiration durations
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Default password assigned to seeded test users across all roles (OWNER, CFO, PM, GC, INVESTOR)
SEED_DEFAULT_PASSWORD=Password123!

# ------------------------------------------------------------------------------
# 4. STORAGE & ATTACHMENT UPLOADS
# ------------------------------------------------------------------------------
# Directory where draw packages, invoices, lien waivers, and receipts are stored.
STORAGE_DIR=storage_data

# ------------------------------------------------------------------------------
# 5. FRONTEND CONFIGURATION (Next.js 14 App Router)
# ------------------------------------------------------------------------------
# Public API base path (Next.js automatically proxies /api/v1 to http://localhost:8000/api/v1)
NEXT_PUBLIC_API_BASE_URL=/api/v1

# Demo credentials helper for quick login during testing
NEXT_PUBLIC_DEMO_PASSWORD=Password123!
