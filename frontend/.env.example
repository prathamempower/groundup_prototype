# ==============================================================================
# GroundUp AI - Frontend Environment Template
# ==============================================================================
# Copy this file to .env.local before running the Next.js development server:
#   cp .env.example .env.local
# ==============================================================================

# Public API Base URL
# By default, Next.js rewrites /api/v1 to http://localhost:8000/api/v1
NEXT_PUBLIC_API_BASE_URL=/api/v1

# Quick-fill demo credentials for local development testing
NEXT_PUBLIC_DEMO_PASSWORD=Password123!
