# ==============================================================================
# GroundUp AI - Backend Standalone Environment Template
# ==============================================================================
# Copy this file to .env before running backend services or tests:
#   cp .env.example .env
# ==============================================================================

# Database Configuration (PostgreSQL 16)
POSTGRES_USER=groundup
POSTGRES_PASSWORD=groundup_password
POSTGRES_DB=groundup_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5436

DATABASE_URL=postgresql+psycopg2://groundup:groundup_password@localhost:5436/groundup_db
ASYNC_DATABASE_URL=postgresql+asyncpg://groundup:groundup_password@localhost:5436/groundup_db
DB_ECHO=false

# Application & API
PROJECT_NAME="GroundUp AI API"
VERSION="0.1.0"
API_V1_STR="/api/v1"
ENV=development
DEBUG=true

# Security & Secrets
SECRET_KEY=groundup-dev-secret-key-change-in-production-min-32-chars-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
SEED_DEFAULT_PASSWORD=Password123!

# CORS Origins
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000","http://127.0.0.1:8000"]

# Storage Location
STORAGE_DIR=../storage_data
